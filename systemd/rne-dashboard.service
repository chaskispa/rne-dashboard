[Unit]
Description=RNE LED Panel Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rne-dashboard
Group=rne-dashboard
WorkingDirectory=/opt/rne-dashboard
Environment=NODE_ENV=production
Environment=PORT=4173
Environment=HOST=0.0.0.0
Environment=RNE_DATA_DIR=/var/lib/rne-dashboard
Environment=RNE_ADMIN_TOKEN_FILE=/var/lib/rne-dashboard/admin-token
Environment=RNE_NETWORK_HELPER=/usr/local/lib/rne-dashboard/network-helper
ExecStart=/usr/bin/node /opt/rne-dashboard/server.js
Restart=on-failure
RestartSec=5
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/rne-dashboard

[Install]
WantedBy=multi-user.target
